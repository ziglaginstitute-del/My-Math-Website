{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/assets/community_uploads/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/assets/vault_pdfs/(.*)",
      "destination": "/api/index"
    }
  ]
}
